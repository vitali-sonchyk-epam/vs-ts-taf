{
  "name": "vs-ts-taf",
  "version": "1.0.0",
  "description": "Automated Testing Mentoring with JS: Intermediate",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep \"@smoke\"",
    "test:headed": "playwright test --headed",
    "agent:chain": "tsx agents/chain",
    "agent:orchestrator": "tsx agents/orchestrator",
    "report:clean": "node -e \"require('fs').rmSync('allure-results',{recursive:true,force:true})\"",
    "report:generate": "allure generate allure-results --clean -o allure-report",
    "report:open": "allure open allure-report",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pwreport:clean": "node -e \"require('fs').rmSync('playwright-report',{recursive:true,force:true})\"",
    "html:report": "playwright show-report"
  },
  "license": "EPAM Systems",
  "engines": {
    "node": ">=18.20.0"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.252",
    "@anthropic-ai/sdk": "^0.122.0",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@playwright/test": "^1.62.1",
    "@reportportal/agent-js-playwright": "^5.4.2",
    "@types/node": "^22.20.1",
    "allure-commandline": "^2.43.0",
    "allure-js-commons": "^3.10.2",
    "allure-playwright": "^3.10.2",
    "csv-file-validator": "^2.2.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.11.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "winston": "^3.19.0",
    "zod": "^4.5.4"
  }
}
