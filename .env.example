# Copy this file to `.env` and adjust values for your local setup.

# Base URL under test
BASE_URL=https://cloud.google.com

# Run the browser without a visible window (true) or headed (false)
HEADLESS=false

# Logging verbosity: trace | debug | info | warn | error
LOG_LEVEL=debug

# Test reporter to use: list | html | allure | junit | reportportal
REPORTER=html

# Endpoint of your ReportPortal server (use the v2 async API).
RP_ENDPOINT=https://reportportal.epam.com/api/v2
# The ReportPortal project name your launches are created in.
RP_PROJECT=your_project_name
# Your personal UUID access token from the ReportPortal profile page.
RP_API_KEY=your-uuid-token
# Display name for the launch created in ReportPortal.
RP_LAUNCH=vs-ts-taf

# Directory where downloaded test artifacts are saved
DOWNLOAD_PATH=./downloads

